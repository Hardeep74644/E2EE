# Environment variables template — copy to .env and fill in values
# .env is gitignored — NEVER commit .env with real secrets

# PostgreSQL credentials (must match homeserver.yaml database.args)
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Synapse secrets (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
SYNAPSE_MACAROON_SECRET_KEY=CHANGE_THIS_RANDOM_64_CHAR_STRING
SYNAPSE_FORM_SECRET=CHANGE_THIS_DIFFERENT_RANDOM_64_CHAR_STRING

# Server hostname
SERVER_NAME=chat.local
PUBLIC_BASEURL=https://chat.local/
